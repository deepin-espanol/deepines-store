InstallFiles() {
	REPO="deb http://repositorio.deepines.com/pub/deepines/%d/ stable main"
	mkdir -p $TRUSTED_DIR
	mkdir -p $SOURCES_DIR
	$Fmt "${REPO}\n" "$1" >$DEEPINES_LIST
	MakeRepoKey >$DEEPINES_KEY
}

InstallDeepinesRepository() {
	$Fmt "${INSTALLING_DEEPINES}" "$1" && RepoInstallationResult=$(
		InstallFiles "$1" 2>&1
	) || {
		$Fmt "$INSTALLING_FAILED"
		echo "$RepoInstallationResult"
		db_go || true
		exit 1
	} && $Fmt "$INSTALLING_DONE"
}

InstallDeepines() {
	REL_NUM=$(lsb_release -rs)
	case $REL_NUM in
	20 | 20.*) InstallDeepinesRepository 4 ;;
	"23 Nightly" | 23 | 23.*) InstallDeepinesRepository 5 ;;
	25 | 25.*) InstallDeepinesRepository 6 ;;
	esac
}

InstallFlathubRepository() {
	# Prefer the Python helper if available
	if command -v python3 >/dev/null 2>&1 && [ -f "/usr/share/deepines/deepinesStore/install_flathub.py" ]; then
		# Run helper; don't fail the installer if it returns non-zero
		python3 /usr/share/deepines/deepinesStore/install_flathub.py || true
		return 0
	fi

	$Fmt "${INSTALLING_FLATHUB}"

	# Fallback to the original shell implementation if Python helper isn't available
	# If flatpak isn't available, skip Flathub setup
	if ! command -v flatpak >/dev/null 2>&1; then
		$Fmt "$INSTALLING_FAILED"
		$Fmt "$FLATHUB_NOT_FOUND"
		return 0
	fi

	# Capture all flatpak output into a temp file so we preserve stderr/stdout
	TMP_OUT=$(mktemp 2>/dev/null || printf '/tmp/deepines_flathub.%s' "$$")

	# Temporarily disable errexit so failures inside this block don't abort the installer
	set +e
	{
		flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
		flatpak update --appstream --assumeyes
		flatpak install flathub org.gtk.Gtk3theme.deepin org.gtk.Gtk3theme.deepin-dark --assumeyes
	} >"$TMP_OUT" 2>&1
	set -e

	FlathubInstallationResult=$(cat "$TMP_OUT" 2>/dev/null || true)
	rm -f "$TMP_OUT" 2>/dev/null || true

	# If the remote exists we consider it successful; otherwise show the captured output and continue
	if flatpak remote-list 2>/dev/null | grep -q '^flathub\b'; then
		$Fmt "$INSTALLING_DONE"
	else
		$Fmt "$INSTALLING_FAILED"
		printf '%s\n' "$FlathubInstallationResult"
		$Fmt "$FLATHUB_CONTINUE"
	fi
}

case "$1" in
configure)
	InstallDeepines
	InstallFlathubRepository
	;;
esac

exit 0
